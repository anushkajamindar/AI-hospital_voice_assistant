# Copy this file to .env and fill in real values. Never commit .env.

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1xxxxxxxxxx

# OpenAI (Whisper fallback transcription)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Hospital
HOSPITAL_NAME=City Care Hospital

# Storage
EXCEL_FILE_PATH=data/appointments.xlsx

# Filled in automatically by start_ngrok.py
NGROK_URL=

# Only needed for test_call.py
TEST_TO_NUMBER=+91xxxxxxxxxx

# Optional: Google Calendar (not used by the default Excel-based flow)
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
